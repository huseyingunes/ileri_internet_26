diff --git a/haber10da/.github/workflows/ci.yml b/haber10da/.github/workflows/ci.yml
deleted file mode 100644
index e56d0f5..0000000
--- a/haber10da/.github/workflows/ci.yml
+++ /dev/null
@@ -1,69 +0,0 @@
-# Sürekli entegrasyon: her gönderim ve çekme isteğinde kod denetimi + testler + imaj derleme.
-name: CI
-
-on:
-  push:
-    branches: [main]
-  pull_request:
-
-jobs:
-  test:
-    runs-on: ubuntu-latest
-    # Testler varsayılan olarak gömülü PGlite kullanır; burada ayrıca gerçek PostgreSQL ve Redis
-    # servis konteynerleriyle de çalıştırılır (TEST_DATABASE_URL / TEST_REDIS_URL).
-    services:
-      postgres:
-        image: pgvector/pgvector:pg16
-        env:
-          POSTGRES_DB: haber10da_test
-          POSTGRES_USER: test
-          POSTGRES_PASSWORD: test
-        ports: ['5432:5432']
-        options: >-
-          --health-cmd "pg_isready -U test" --health-interval 5s --health-retries 10
-      redis:
-        image: redis:7-alpine
-        ports: ['6379:6379']
-        options: >-
-          --health-cmd "redis-cli ping" --health-interval 5s --health-retries 10
-    strategy:
-      matrix:
-        veritabani: [pglite, postgresql]
-    steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
-        with:
-          node-version: 22
-          cache: npm
-      - run: npm ci
-      - run: npm run lint
-      - name: Testler (${{ matrix.veritabani }})
-        run: npm test
-        env:
-          TEST_DATABASE_URL: ${{ matrix.veritabani == 'postgresql' && 'postgres://test:test@localhost:5432/haber10da_test' || '' }}
-          TEST_REDIS_URL: ${{ matrix.veritabani == 'postgresql' && 'redis://localhost:6379' || '' }}
-
-  imaj:
-    needs: test
-    runs-on: ubuntu-latest
-    permissions:
-      contents: read
-      packages: write
-    steps:
-      - uses: actions/checkout@v4
-      - uses: docker/setup-buildx-action@v3
-      - uses: docker/login-action@v3
-        if: github.event_name == 'push'
-        with:
-          registry: ghcr.io
-          username: ${{ github.actor }}
-          password: ${{ secrets.GITHUB_TOKEN }}
-      - uses: docker/build-push-action@v6
-        with:
-          context: .
-          push: ${{ github.event_name == 'push' }}
-          tags: |
-            ghcr.io/${{ github.repository }}:latest
-            ghcr.io/${{ github.repository }}:${{ github.sha }}
-          cache-from: type=gha
-          cache-to: type=gha,mode=max
diff --git a/haber10da/.github/workflows/dagitim.yml b/haber10da/.github/workflows/dagitim.yml
deleted file mode 100644
index b6b88a2..0000000
--- a/haber10da/.github/workflows/dagitim.yml
+++ /dev/null
@@ -1,35 +0,0 @@
-# Sürekli dağıtım: CI başarılı olunca sunucuya SSH ile bağlan, yeni imajı çek, sıfır kesintiyle yeniden başlat.
-# Gerekli depo gizleri (Settings → Secrets → Actions):
-#   SUNUCU_ADRES, SUNUCU_KULLANICI, SUNUCU_SSH_ANAHTARI
-name: Dağıtım
-
-on:
-  workflow_run:
-    workflows: [CI]
-    types: [completed]
-    branches: [main]
-
-jobs:
-  dagit:
-    if: github.event.workflow_run.conclusion == 'success'
-    runs-on: ubuntu-latest
-    environment: uretim
-    steps:
-      - name: Sunucuda güncelle
-        uses: appleboy/ssh-action@v1.2.0
-        with:
-          host: ${{ secrets.SUNUCU_ADRES }}
-          username: ${{ secrets.SUNUCU_KULLANICI }}
-          key: ${{ secrets.SUNUCU_SSH_ANAHTARI }}
-          script: |
-            set -e
-            cd ~/haber10da
-            git pull --ff-only
-            export IMAJ=ghcr.io/${{ github.repository }}:${{ github.event.workflow_run.head_sha }}
-            docker compose pull uygulama worker
-            # Önce worker, sonra uygulama: göçler uygulama açılışında çalışır
-            docker compose up -d --no-deps worker
-            docker compose up -d --no-deps --wait uygulama
-            docker image prune -f
-      - name: Duman testi
-        run: curl --fail --retry 5 --retry-delay 5 https://haber10da.net/api/hazir
