# haber10da ortam değişkenleri. Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Hiçbirini doldurmadan da çalışır (npm run dev): gömülü PostgreSQL + bellek içi önbellek + yerel özet.

# --- Genel
PORT=3000
# SITE_URL=https://haber10da.net
# LOG_LEVEL=info

# --- Veritabanı (boşsa gömülü PGlite, ./.veri klasöründe)
# DATABASE_URL=postgres://haber:haber@localhost:5432/haber10da

# --- İsteğe bağlı servisler (boşsa bellek içi yedekler devreye girer)
# REDIS_URL=redis://localhost:6379
# AMQP_URL=amqp://haber:haber@localhost:5672
# ELASTIC_URL=http://localhost:9200

# --- Kimlik doğrulama (üretimde JWT_SECRET zorunlu: openssl rand -hex 32)
# JWT_SECRET=
# ADMIN_EPOSTA=admin@haber10da.net
# ADMIN_PAROLA=
# GitHub OAuth uygulaması: github.com/settings/developers
#   Callback URL: <SITE_URL>/api/auth/github/geri-donus
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Prometheus /api/metrics için HTTP Basic parolası
# METRIK_PAROLA=

# --- Yapay zekâ (OpenAI uyumlu her uç nokta)
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
#
# Kendi sunucunuzdaki vLLM:
# LLM_BASE_URL=http://sunucu:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# EMBED_BASE_URL=http://sunucu:8001/v1
# EMBED_MODEL=BAAI/bge-m3
#
# Ollama (yerel):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# EMBED_MODEL=nomic-embed-text
#
# Gömme vektör boyutu veritabanında 768 olarak sabit; farklı boyutlu modeller kırpılır/doldurulur.
# EMBED_BOYUT=768

# --- RSS toplayıcı (worker 15 dakikada bir çalıştırır): adres|kategori|kaynak adı
# RSS_KAYNAKLARI=https://ornek.edu.tr/rss|kampus|Örnek Üniversite

# --- Docker Compose
# POSTGRES_PAROLA=
# RABBIT_PAROLA=
# NGINX_SITE=ilk-kurulum.conf
# IMAJ=ghcr.io/kullanici/haber10da:latest
